# Values can reference environment variables with "${VAR_NAME}", e.g.:
#   aas_token: '${GOOGLE_PLAY_AAS_TOKEN}'
# Useful to keep real secrets out of config.yaml (which is still gitignored).
google_play:
  email: ''
  aas_token: ''
downloader:
  output_dir: ./downloads
  keep_apk: true
reports:
  output_dir: ./reports
  save_json: false
  save_pdf: true

# ── Language ──────────────────────────────────────────────────────────────────
# Report language. Supported: en (English) | es (Spanish). Default: en
language: en

# Timezone for timestamps in PDF reports. Use IANA names, e.g.: America/Lima,
# America/Bogota, America/Mexico_City, Europe/Madrid. Default: UTC
timezone: UTC

# ── Feature flags ─────────────────────────────────────────────────────────────
# Enable or disable each pipeline module.
features:
  anti_root_analysis: true   # protection detection (root-check, DexGuard, etc.)
  decompilation: true        # APK decompilation (jadx or runtime)
  manifest_scan: true        # AndroidManifest.xml analysis (misconfigurations)
  sast_scan: false            # SAST scanning (semgrep or regex)
  leak_scan: true            # secret/token detection in source code
  osint_scan: true           # OSINT: subdomains + public leaks
  report_pdf: true           # auto-generate PDF report
  report_json: false         # save results as JSON

# ── SAST scan ───────────────────────────────────────────────────────────────
sast:
  # Scanning engine.
  # Options: auto (detects semgrep, falls back to regex) | semgrep | regex | none
  engine: auto

  # Semgrep rules (only applies when engine=semgrep).
  # Format: space-separated tokens. E.g.: "p/secrets ./semgrep_rules_android/rules"
  config: p/secrets ./semgrep_rules_android/rules

# ── Leak scan engines ────────────────────────────────────────────────────────
leak_scan:
  native: true        # built-in regex rules (HC*) on decompiled source
  apkleaks: true      # apkleaks on the original APK binary
  gitleaks: true      # gitleaks (700+ rules) on decompiled source

# ── OSINT ─────────────────────────────────────────────────────────────────────
osint:
  crt_sh: true         # enumerate subdomains via crt.sh
  github_search: true      # search for leaks in GitHub Code Search (requires token for real results)
  github_token: ''          # optional GitHub PAT for Code Search API (better results / rate limits)
  grep_app_search: true     # search public GitHub repos via grep.app (no token required)
  fofa_search: false   # search exposed assets in FOFA
  fofa_key: ''         # FOFA API key for /api/v1/search/all
  shodan_search: false  # search exposed assets in Shodan
  shodan_key: ''        # Shodan API key for host search
  postman_search: true # search for public collections in Postman
  execute_dorks: false # opt-in: run web searches (DuckDuckGo) against target domains
  dork_engines:        # engines used when execute_dorks=true
    - duckduckgo
  dork_max_per_engine: 5        # cap of dorks per engine (rate-limit safety)
  dork_max_results_per_dork: 5  # cap of results per dork
  wayback_search: true                # archive.org CDX per target domain
  wayback_limit_per_domain: 200       # cap of archived URLs per domain
  wayback_filter_interesting: true    # only return admin/debug/secrets-like paths

# ── Analysis strategies ──────────────────────────────────────────────────────
strategies:
  # Protection detection engine.
  # Options: native (built-in, fast) | apkid (more detailed, requires apkid)
  anti_root_engine: native

  # Show emulator window (false = headless).
  show_emulator: true

  # Where to run runtime analysis (Frida, FART, etc.).
  # Options: auto (emulator if AVD available, otherwise device) | emulator | device
  runtime_target: emulator

  # Default AVD name for the emulator.
  # If empty, the first available AVD is used.
  default_emulator_avd: ''

  # Physical device serial (from adb devices).
  # If empty, auto-detected.
  default_device_id: ''

  # Frida connection over TCP instead of USB.
  # Format: "host:port" (e.g.: "192.168.1.50:27042").
  # If empty, USB is used (-D serial / -U).
  # Applies to frida, frida-dexdump, and FART.
  frida_host: ''

  # frida-server version to install on the device (e.g.: "17.4.0").
  # If empty, uses the frida version from the Python environment.
  frida_server_version: ''

# ── Pipelines by app type ────────────────────────────────────────────────────
pipelines:
  # Protected apps (DexGuard, Arxan, root-check detected).
  protected:
    # Decompilation method.
    # Options: runtime (Frida/FART in-memory extraction) | jadx (static)
    decompilation: runtime

    # If runtime fails, try jadx as fallback.
    fallback_jadx: true

    # Runtime methods to execute, in the order listed below.
    # Options: frida_server | gadget | fart
    #   frida_server — runtime extraction using Frida with frida-server on the device or emulator
    #   gadget       — instrumentation via Frida Gadget embedded into the APK
    #   fart         — alternative runtime DEX extraction flow
    runtime_methods:
    - frida_server
    - gadget
    - fart

  # Unprotected apps (no protection detected).
  unprotected:
    # Decompile directly with jadx.
    decompilation_jadx: true

# ── Post-hooks ───────────────────────────────────────────────────────────────
# Plugins to run automatically after each scan/analyze finishes.
# Available: ai-review (filter false positives with LLM, needs llm: configured)
post_hooks: []          # e.g.: [ai-review]

# ── ai-review plugin options (used when ai-review is in post_hooks) ───────────
ai_review:
  batch_size: 8         # findings per LLM call
  context_lines: 4      # source lines around each match sent as context
  regen_pdf: true       # regenerate PDF after filtering

# ── Auto mode ─────────────────────────────────────────────────────────────────
auto:
  unattended: true     # skip all confirmation prompts

# ── Batch mode ────────────────────────────────────────────────────────────────
batch:
  list_file: ''           # path to the list file (optional if passed as CLI argument)
  stop_on_error: false    # stop batch processing if an app fails

# ── Persistence (SQLite) ──────────────────────────────────────────────────────
# Every analysis is also recorded in a local SQLite DB (runs/findings/artifacts),
# in addition to the existing reports/<pkg>/*.json and PDF (non-destructive).
store:
  enabled: true          # set false to skip SQLite persistence entirely
  db_path: ''            # empty = ./nutcracker.db at the project root

# ── Queue (mass execution — plan.md Fase 1) ────────────────────────────────────
# `nutcracker queue add`/`nutcracker serve`: static jobs (decompile/scan/OSINT)
# run in parallel; dynamic jobs (Frida/ADB on a physical device) are always
# serialized per device serial, regardless of dynamic_workers.
queue:
  static_workers: 1      # parallel static analyses at once
  dynamic_workers: 1      # concurrent *devices* for dynamic jobs (never same serial)

# ── Scheduler (periodic reviews — plan.md Fase 1.2) ────────────────────────────
# `nutcracker serve` re-queues every app whose next_due_at has passed, and
# reschedules it after each run using its own `schedule` entry (or this default).
scheduler:
  enabled: true
  poll_interval_minutes: 60      # how often the daemon checks for due apps
  default_interval_days: 30      # ≥1 review/month per app unless overridden

# ── Web dashboard (plugin — plan.md Fase 3) ────────────────────────────────────
# `nutcracker dashboard`: starts its own queue + scheduler + a local web UI
# (apps, live job logs, device screenshot, MASVS trend, schedule editor).
dashboard:
  bind: '127.0.0.1'
  port: 8765
  # Video en vivo del dispositivo: pestaña "Dispositivo" -> "🔌 USB directo
  # (fluido)" (WebUSB + WebCodecs, ver nutcracker_core/plugins/dashboard/webusb/).
  # Es la única vía de video: no hay fallback por screenshots.
  #
  # El navegador reclama el cable USB en exclusiva para ese video, así que
  # nutcracker debe hablarle al teléfono por el serial de red
  # (strategies.default_device_id = "<ip>:5555", tras `adb tcpip 5555`). Ese
  # transporte TCP vive en el daemon adb y se cae solo (reinicio del daemon,
  # doze/corte de red del teléfono); cada cuántos segundos revisarlo y
  # reconectarlo en segundo plano. Mínimo efectivo: 10.
  adb_keepalive_seconds: 60
  # ── Login del dashboard (obligatorio para exponerlo a internet) ──────────
  # Sin esto el dashboard no pide autenticación: cualquiera con acceso de red
  # puede operarlo (encolar jobs, manejar el relay al dispositivo, leer
  # reportes). Para uso local (bind 127.0.0.1) podés dejarlo deshabilitado;
  # para un despliegue en VPS (ver deploy/README.md) es imprescindible.
  #
  # Generá username/password_hash/secret_key con:
  #   python nutcracker.py dashboard-hash-password
  # (pide la contraseña sin eco e imprime este bloque listo para pegar). NUNCA
  # guardes la contraseña en texto plano -- solo el hash pbkdf2 va acá.
  auth:
    enabled: false
    username: admin
    password_hash: ''   # pbkdf2_sha256$...  (dashboard-hash-password)
    # Firma las cookies de sesión. Con una clave fija las sesiones sobreviven
    # reinicios del server; si se deja vacía se genera una al arrancar (habría
    # que re-loguearse tras cada reinicio). Generar una:
    #   python -c "import secrets; print(secrets.token_urlsafe(48))"
    secret_key: ''
    session_hours: 12   # duración de la sesión antes de re-loguear
# ── Toolbox estático en Docker (opt-in) ────────────────────────────────────
# Sandboxea jadx/apktool (y a futuro otras herramientas estáticas) dentro de
# un contenedor Docker en vez de invocar binarios instalados en el host --
# útil para no depender de tener cada herramienta instalada localmente (este
# mismo entorno, por ejemplo, no tiene jadx) y para aislar el análisis de
# APKs de terceros (potencialmente maliciosos) del resto del sistema.
#
# Herramientas dinámicas (adb, frida) NUNCA pasan por acá -- necesitan hablar
# directo con el dispositivo físico conectado al host. Ver
# nutcracker_core/toolbox/ para el diseño completo.
toolbox:
  enabled: false   # true = decompilar vía Docker en vez de binarios locales
  image: 'nutcracker-toolbox-static:latest'
  # Techo de memoria por contenedor (formato Docker: '4g', '2048m', ...). Sin
  # esto, un jadx desbocado contra un APK grande/ofuscado puede agotar TODA
  # la VM compartida de WSL2 (Docker Desktop comparte el mismo pool) y
  # tirarse abajo con ella el dashboard y otros jobs. --memory-swap se fija
  # igual a este valor (sin swap extra) para que un contenedor que se pasa
  # del límite muera rápido por su cgroup en vez de entrar en swap thrashing.
  memory_limit: '4g'

