# Caddyfile para exponer el dashboard de nutcracker con HTTPS automático
# (Let's Encrypt, renovación sola). Reemplazar {$NUTCRACKER_DOMAIN} por el
# dominio/subdominio real (ej. tuusuario.duckdns.org) antes de copiar al VPS,
# o exportar la env var NUTCRACKER_DOMAIN antes de arrancar Caddy.
#
# WebUSB (navigator.usb) exige "secure context": HTTP plano en un dominio
# público lo bloquea por completo -- por eso este proxy es obligatorio para
# el despliegue en VPS, no opcional. Caddy proxea WebSocket sin config extra
# (detecta el header Upgrade automáticamente), así que /ws/jobs, /ws/chat y
# /ws/relay funcionan igual detrás del proxy.

{$NUTCRACKER_DOMAIN} {
	reverse_proxy 127.0.0.1:8765
}
