# Plugin outputs / memory -- todos los plugins quedan fuera del repo principal
# EXCEPTO dashboard/ y aipwn/, que pasaron a ser parte del proyecto principal
# (ya no son repos git separados). El patrón debe ser "*" (no "plugins/" a
# secas): git no puede des-ignorar algo dentro de un directorio que ya está
# ignorado como unidad completa, solo dentro de uno cuyo contenido se ignora
# entrada por entrada.
nutcracker_core/plugins/*
!nutcracker_core/plugins/dashboard/
!nutcracker_core/plugins/aipwn/
aipwn_memory/

# Backup files
*.bk

# Artefactos de build del dashboard (se regeneran con pnpm build en webusb/)
# El HTML los carga de forma perezosa -- sin build, esa funcionalidad queda
# deshabilitada con un warning, no rompe el dashboard.
nutcracker_core/plugins/dashboard/static/webusb-video.bundle.js
nutcracker_core/plugins/dashboard/static/assets/worker-*.js
